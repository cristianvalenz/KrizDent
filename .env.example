# =====================================================================
# KrizDent — variables de entorno
# Copia este archivo como  .env  y rellena los valores reales.
# NUNCA subas el .env a GitHub: contiene la llave con acceso total a la BD.
# =====================================================================

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase → Project Settings → API Keys → service_role  (la llave "secret")
# Se usa desde el backend, nunca desde el navegador.
SUPABASE_KEY=eyJhbGciOi...

# Nombre del bucket de Storage donde se guardan radiografías y fotos
SUPABASE_BUCKET=historial

# Clave para firmar las sesiones de Flask. Cualquier texto largo y aleatorio.
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-algo-aleatorio

# Modo desarrollo (recarga automática al guardar archivos)
FLASK_DEBUG=1
